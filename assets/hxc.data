	public function containsRect(rect:Rectangle):Bool
	{
		if (rect.width <= 0 || rect.height <= 0)
		{
			return rect.x > x && rect.y > y && rect.right < right && rect.bottom < bottom;
		}
		else
		{
			return rect.x >= x && rect.y >= y && rect.right <= right && rect.bottom <= bottom;
		}
