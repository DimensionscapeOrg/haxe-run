	}

	@:noCompletion private function get_bottomRight():Vector2
	{
		return new Vector2(x + width, y + height);
	}

	@:noCompletion private function set_bottomRight(p:Vector2):Vector2
	{
		width = p.x - x;
		height = p.y - y;
