	#end

	public function new(x:Float = 0, y:Float = 0, scaleX:Float = 1, scaleY:Float = 1, rotation:Float = 0, originX:Float = 0, originY:Float = 0)
	{
		super(-1, x, y, scaleX, scaleY, rotation, originX, originY);

