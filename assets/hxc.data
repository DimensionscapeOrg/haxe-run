package sys.db;

class Mysql {
	public static function connect(params:{
		host:String,
		?port:Int,
		user:String,
		pass:String,
		?socket:String,
		?database:String
	}):sys.db.Connection {
		throw new haxe.exceptions.NotImplementedException("Not implemented for this platform");
		return null;
	}
}
