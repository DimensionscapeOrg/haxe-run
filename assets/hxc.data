		// \0  -> \x00
		// \v  -> \x0b
		// [^] -> [\s\S]
		// unescaped ', " -> \', \"
		/* FIXME
			var pat = new StringBuf();
			var len = r.length;
			var i = 0;
			while (i < len)
			{
				var c = StringTools.fastCodeAt(r, i++);
				switch(c)
