			if (typeAsString != partName)
			{
				continue;
			}
			result = part.value;
		}
		return result;
	}

	public function getMonthNames(nameStyle:DateTimeNameStyle = FULL, context:DateTimeNameContext = STANDALONE):Vector<String>
	{
