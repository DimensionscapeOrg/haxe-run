		y = t;
		return t;
	}

	@:noCompletion private function get_topLeft():Vector2
	{
		return new Vector2(x, y);
	}

	@:noCompletion private function set_topLeft(p:Vector2):Vector2
	{
		x = p.x;
		y = p.y;
		return p.clone();
	}
