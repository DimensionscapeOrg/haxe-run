	@:noCompletion @:keep
	@:php.attribute('\\ReturnTypeWillChange')
	function offsetExists(offset:Int):Bool {
		return offset < length;
	}

	@:noCompletion @:keep
	@:php.attribute('\\ReturnTypeWillChange')
	function offsetGet(offset:Int):Ref<T> {
