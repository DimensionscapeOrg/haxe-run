	public function new(width:Int = 320, height:Int = 240):Void
	{
		super();

		__drawableType = VIDEO;
		__width = width;
		__height = height;

		__textureTime = -1;

		smoothing = false;
		deblocking = 0;
	}

	#if false
	/**
		Specifies a video stream from a camera to be displayed within the
		boundaries of the Video object in the application.
