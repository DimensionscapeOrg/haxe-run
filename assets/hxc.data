		resulting RGB value for the displayed pixel is 0x338400 (because 0xDD -
		0xAA = 0x33, 0xA6 - 0x22 = 0x84, and 0x00 - 0x33 < 0x00).
	**/
	public var SUBTRACT = 14;

	@:from private static function fromString(value:String):BlendMode
	{
		return switch (value)
