	public function get(att:String):String {
		if (nodeType != Xml.Element)
			throw "bad nodeType";
		var ns = att.split(":");
		if (ns[0] == "xmlns") {
			var n = _node.namespace((ns[1] == null) ? "" : ns[1]);
			return (n == null) ? null : n.uri;
