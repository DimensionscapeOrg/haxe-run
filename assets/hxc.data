	var result:Dynamic;

	public function new(r:String, opt:String):Void {
		this.r = new flash.utils.RegExp(r, opt);
	}

	public function match(s:String):Bool {
		if (r.global)
			r.lastIndex = 0;
		result = r.exec(s);
		return (result != null);
