	var gles3:OpenGLES3RenderContext = gl;
	var gles3:OpenGLES3RenderContext = GL;

	var gles2:OpenGLES2RenderContext = gles3;
	var webgl2:WebGL2RenderContext = gles3;
	var webgl:WebGLRenderContext = gles3;
	```
**/
