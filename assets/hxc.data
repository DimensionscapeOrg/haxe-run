				}
			}
		}
		else
		{
			var hitTest = false;

			while (--i >= 0)
			{
				if (__children[i].__hitTest(x, y, shapeFlag, stack, false, cast __children[i]))
				{
					hitTest = true;
					if (stack == null) break;
				}
			}

			return hitTest;
		}

		return false;
	}

	@:noCompletion private override function __hitTestMask(x:Float, y:Float):Bool
	{
		var i = __children.length;

		while (--i >= 0)
