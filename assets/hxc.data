				__vertexBufferGrid.copyFrom(scale9Grid);

				__vertexBufferWidth = targetObject.width;
				__vertexBufferHeight = targetObject.height;
				__vertexBufferScaleX = targetObject.scaleX;
				__vertexBufferScaleY = targetObject.scaleY;

