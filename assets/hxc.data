		return (ns.prefix == "") ? _node.localName() : ns.prefix + ":" + _node.localName();
	}

	private function set_nodeName(n:String):String {
		if (nodeType != Xml.Element)
			throw "bad nodeType";
		var ns = n.split(":");
		if (ns.length == 1)
			_node.setLocalName(n);
		else {
