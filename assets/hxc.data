	@:inheritDoc(eval.luv.Dir.read)
	static public function read(dir:Dir, ?numberOfEntries:Int):Result<Array<Dirent>>;

	@:inheritDoc(eval.luv.Dir.scan)
	static public function scan(path:NativeString):Result<DirectoryScan>;
