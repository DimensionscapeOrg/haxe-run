extern enum abstract SigNum(Int) from Int to Int {
	var SIGABRT;
	var SIGFPE;
	var SIGHUP;
	var SIGILL;
	var SIGINT;
	var SIGKILL;
	var SIGSEGV;
	var SIGTERM;
	var SIGWINCH;
