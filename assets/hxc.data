	extern private static inline function assert(x:Bool):Void {
		#if DEBUG_HASHTBL
		if (!x)
			throw "assert failed";
		#end
	}
}

@:access(haxe.ds.ObjectMap)
private final class ObjectMapKeyIterator<T:{}, V> {
	var m:ObjectMap<T, V>;
	var i:Int;
	var len:Int;

	public function new(m:ObjectMap<T, V>) {
		this.i = 0;
		this.m = m;
		this.len = m.nBuckets;
	}

	public function hasNext():Bool {
		for (j in i...len) {
			if (!ObjectMap.isEither(m.hashes[j])) {
				i = j;
				return true;
			}
		}
		return false;
	}

	public function next():T {
		var ret = m._keys[i];

		#if !no_map_cache
		m.cachedIndex = i;
		m.cachedKey = ret;
		#end

		i = i + 1;
		return ret;
	}
}

@:access(haxe.ds.ObjectMap)
private final class ObjectMapValueIterator<K:{}, T> {
	var m:ObjectMap<K, T>;
	var i:Int;
	var len:Int;

