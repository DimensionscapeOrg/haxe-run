	var FTP_COULDNT_USE_REST = 31;
	// var OBSOLETE32 = 32;
	var RANGE_ERROR = 33;
	var HTTP_POST_ERROR = 34;
	var SSL_CONNECT_ERROR = 35;
	var BAD_DOWNLOAD_RESUME = 36;
