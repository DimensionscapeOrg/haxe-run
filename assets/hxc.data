package haxe.io;

/**
	This exception is raised when reading while data is no longer available in the `haxe.io.Input`.
**/
class Eof {
	public function new() {}

	@:ifFeature("haxe.io.Eof.*")
	function toString() {
		return "Eof";
	}
}
