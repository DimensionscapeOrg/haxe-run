	public var HObj = 11;
	public var HArray = 12;
	public var HType = 13;
	public var HRef = 14;
	public var HVirtual = 15;
	public var HDynObj = 16;
	public var HAbstract = 17;
	public var HEnum = 18;
	public var HNull = 19;
}

@:coreType abstract Type {
	public var kind(get, never):TypeKind;

