			return true;
		}
		var targetTime = haxe.Timer.stamp() + timeout;
		do {
			if (deque.pop(false) != null) {
				return true;
			}
		} while (haxe.Timer.stamp() < targetTime);
		return false;
	}

	public function release():Void {
		deque.push(true);
	}
}

