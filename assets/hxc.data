package openfl.desktop;

#if (haxe4 && !flash && sys && (!flash_doc_gen || air_doc_gen))
import haxe.Json;
import haxe.Serializer;
import haxe.io.Bytes;
import haxe.io.BytesInput;
import haxe.io.BytesOutput;
import haxe.io.Eof;
