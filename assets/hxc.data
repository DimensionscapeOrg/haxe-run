@SuppressWarnings("checkstyle:FieldDocComment")
abstract Dictionary<K, V>(Dynamic)
{
	public function new(weakKeys:Bool = false)
	{
		this = {};
	}

	public inline function exists(key:K):Bool
	{
		return Reflect.hasField(this, cast key);
