private class SqliteResultSet implements ResultSet {
	public var length(get, null):Int;
	public var nfields(get, null):Int;

	var r:Dynamic;
	var cache:List<Dynamic>;

	public function new(r) {
		cache = new List();
		this.r = r;
		hasNext(); // execute the request
	}

	function get_length() {
		if (nfields != 0) {
			while (true) {
				var c = doNext();
				if (c == null)
					break;
				cache.add(c);
