package sys.net;

/**
	An address is used to represent a port on a given host ip.
	It is used by `sys.net.UdpSocket`.
**/
class Address {
	public var host:Int;
	public var port:Int;

	public function new() {
		host = 0;
		port = 0;
	}

	public function getHost() {
		var h = new Host("127.0.0.1");
		untyped h.ip = host;
		return h;
	}

	public function compare(a:Address) {
		var dh = a.host - host;
		if (dh != 0)
			return dh;
		var dp = a.port - port;
		if (dp != 0)
			return dp;
		return 0;
	}

	public function clone() {
		var c = new Address();
		c.host = host;
		c.port = port;
		return c;
	}
}
