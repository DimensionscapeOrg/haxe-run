	}

	@:hlNative("std", "file_write") static function file_write(f:FileHandle, bytes:hl.Bytes, pos:Int, len:Int):Int {
		return 0;
	}

	@:hlNative("std", "file_write_char") static function file_write_char(f:FileHandle, v:Int):Bool {
