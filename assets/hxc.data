	private function __get(idx:Int):T {
		return if ((cast idx : UInt) >= length) null else __a[idx];
	}

	private function __set(idx:Int, v:T):T {
		var idx:UInt = idx;
		var __a = __a;
		if (idx >= __a.Length) {
			var len = idx + 1;
			if (idx == __a.Length)
				len = (idx << 1) + 1;
