			else if (stack != null)
			{
				var length = stack.length;

				var interactive = false;
				var hitTest = false;

				while (--i >= 0)
				{
					interactive = __children[i].__getInteractive(null);

					if (interactive || (mouseEnabled && !hitTest))
					{
