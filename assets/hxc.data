				return true;
			}
		}

		return false;
	}

	@:noCompletion private override function __readGraphicsData(graphicsData:Vector<IGraphicsData>, recurse:Bool):Void
	{
		super.__readGraphicsData(graphicsData, recurse);

		if (recurse)
