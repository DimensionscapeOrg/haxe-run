	@:allow(lime._internal.backend.native.NativeWindow)
	private function new(windowHandle:#if (!lime_doc_gen || lime_cffi) CFFIPointer #else Dynamic #end)
	{
		__windowHandle = windowHandle;
		type = VULKAN;
		version = "";
	}

	/**
