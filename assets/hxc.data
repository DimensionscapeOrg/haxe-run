	var Uint8 = 4;
	var Uint8Clamped = 5;
	var Uint16 = 6;
	var Uint32 = 7;
	var Float32 = 8;
	var Float64 = 9;
}

#if (!js || doc_gen)
@:noCompletion @:dox(hide) class ArrayBufferIO
{
