package neko;

@:dox(hide)
@:keep
class Boot {
	private static function __tmp_str() {
		return untyped "<...>".__s;
	}

	private static function __enum_str(e:Dynamic) {
		if (e.args == null)
			return e.tag;
		var s:String = e.tag + untyped "(".__s;
		var i = 0;
