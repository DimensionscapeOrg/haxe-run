		if (ns.length == 1) {
			if (!Reflect.hasField(_node, "@" + att))
				return null;
			return Reflect.field(_node, "@" + att);
		}
		var a = getAttribNS(_node, ns);
		return (a.length() == 0) ? null : a.toString();
