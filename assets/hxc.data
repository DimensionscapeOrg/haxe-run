		return untyped __dollar__hremove(h, key, null);
	}

	public function keys():Iterator<Int> {
		var l = new List<Int>();
		untyped __dollar__hiter(h, function(k, _) {
			l.push(k);
		});
		return l.iterator();
	}

	public function iterator():Iterator<T> {
		var l = new List<T>();
		untyped __dollar__hiter(h, function(_, v) {
			l.push(v);
		});
		return l.iterator();
