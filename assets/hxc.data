	@:hlNative("std", "mutex_try_acquire") public function tryAcquire():Bool {
		return false;
	}

	@:hlNative("std", "mutex_release") public function release() {}

	@:hlNative("std", "mutex_alloc") public static function alloc(b:Bool) {
