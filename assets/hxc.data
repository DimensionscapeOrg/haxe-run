	var minusSign = "minusSign";

	/**
		The NaN string ("NaN").
	**/
	var nan = "nan";

	/**
		The plus sign string ("+").
	**/
	var plusSign = "plusSign";

	/**
		The percent sign string ("%").
	**/
	var percentSign = "percentSign";
}

