		var list = __eventMap.get(type);
		if (list == null) return;

		var iterators = __iterators.get(type);

		for (i in 0...list.length)
		{
			if (list[i].match(listener, useCapture))
			{
				for (iterator in iterators)
				{
					iterator.remove(list[i], i);
