package lua.lib.luasec;

import lua.lib.luasocket.Socket as LuaSocket;

@:luaRequire("ssl")
extern class Ssl {
    static function wrap(sock:LuaSocket, params: SslParams):Result<SslTcpClient>;
}

typedef SslParams = {
    mode: Mode,
