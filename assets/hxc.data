	private static function __isJPG(bytes:Bytes):Bool
	{
		if (bytes == null || bytes.length < 4) return false;

		return bytes.get(0) == 0xFF
			&& bytes.get(1) == 0xD8
			&& bytes.get(bytes.length - 2) == 0xFF
			&& bytes.get(bytes.length - 1) == 0xD9;
