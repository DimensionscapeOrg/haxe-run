	static public function init(value:Int):Result<Semaphore>;

	/**
		Cleans up a semaphore.
	**/
	public function destroy():Void;

	/**
		Increments a semaphore.
	**/
	public function post():Void;

	/**
		Decrements a semaphore.
	**/
