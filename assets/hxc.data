}

typedef Entry = {
	var fileName:String;
	var fileSize:Int;
	var fileTime:Date;
	var compressed:Bool;
	var dataSize:Int;
	var data:Null<haxe.io.Bytes>;
	var crc32:Null<Int>;
	var ?extraFields:List<ExtraField>;
}
