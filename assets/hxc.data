	private function formatPatternJS(date:js.lib.Date, utc:Bool):String
	{
		var result = "";
		var tokens = DateTimeFormatTokenizer.tokenize(this.dateTimePattern);
		var timeZone = utc ? "UTC" : js.Syntax.code("undefined");
		for (token in tokens)
