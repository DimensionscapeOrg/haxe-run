@:coreApi
class Lock {
	final semaphore:Semaphore;

	public inline function new() {
		semaphore = new Semaphore(0);
	}

	public inline function wait(?timeout:Float):Bool {
		return semaphore.acquire(true, timeout);
	}

	public inline function release():Void {
		semaphore.release();
	}
}
