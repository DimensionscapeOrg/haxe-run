	/**
		Evaluates to the signal number associated with the handle.
	**/
	public function signum():Int;
}package eval.luv;

/**
	Network address families.
**/
enum AddressFamily {
	UNSPEC;
	INET;
	INET6;
	OTHER(i:Int);
}

/**
	Socket types.
