	public function matchSub(s:String, pos:Int, len:Int = -1):Bool {
		return if (r.global) {
			r.lastIndex = pos;
			result = r.exec(len < 0 ? s : s.substr(0, pos + len));
			var b = result != null;
			if (b) {
				result.input = s;
			}
			b;
		} else {
			var b = match(len < 0 ? s.substr(pos) : s.substr(pos, len));
			if (b) {
				result.input = s;
				result.index += pos;
			}
			b;
