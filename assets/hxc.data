			|| (renderer.__type != OPENGL
				&& !colorTransform.__isDefault(true) #if (openfl_legacy_scale9grid && openfl_force_gl_cacheasbitmap_for_scale9grid)
					|| (renderer.__type == OPENGL && displayObject.scale9Grid != null) #end))
		{
