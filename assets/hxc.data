@:coreType abstract Ref<T> {
	@:from extern public static inline function make<T>(v:T) {
		return new Ref<T>(v);
	}

	extern public inline function new(v:T) {
		this = untyped $ref(v);
	}

	extern public inline function get():T {
		return untyped $unref(this);
	}

