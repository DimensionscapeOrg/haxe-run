	var Long = "long";

	/**
		(e.g., AD)
	 */
	var Short = "short";

	/**
		(e.g., A)
	 */
	var Narrow = "narrow";
}

enum abstract YearRepresentation(String) {
	/**
		(e.g., 2012)
