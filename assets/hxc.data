@:access(haxe.ds.StringMap)
private final class StringMapKeyIterator<T> {
	var m:StringMap<T>;
	var i:Int;
	var len:Int;

	public function new(m:StringMap<T>) {
		this.m = m;
		this.i = 0;
		this.len = m.nBuckets;
	}

	public function hasNext():Bool {
		for (j in i...len) {
			if (!StringMap.isEither(m.hashes[j])) {
				i = j;
				return true;
			}
		}
		return false;
	}

	public function next():String {
		var ret = m._keys[i];
		#if !no_map_cache
		m.cachedIndex = i;
		m.cachedKey = ret;
		#end
		i++;
		return ret;
	}
}

@:access(haxe.ds.StringMap)
private final class StringMapValueIterator<T> {
	var m:StringMap<T>;
	var i:Int;
	var len:Int;

	public function new(m:StringMap<T>) {
		this.m = m;
		this.i = 0;
		this.len = m.nBuckets;
	}

	public function hasNext():Bool {
		for (j in i...len) {
			if (!StringMap.isEither(m.hashes[j])) {
				i = j;
				return true;
			}
		}
		return false;
	}

	public inline function next():T {
		return m.vals[i++];
	}
}
