package openfl.utils._internal.format.amf;

enum AMFValue
{
	ANumber(f:Float);
	ABool(b:Bool);
	AString(s:String);
	AObject(fields:Map<String, AMFValue>, ?size:Int);
	ADate(d:Date);
	AUndefined;
	ANull;
	AArray(values:Array<AMFValue>);
}
