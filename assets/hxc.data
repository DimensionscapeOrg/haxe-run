	public function set(att:String, value:String):Void {
		if (nodeType != Xml.Element)
			throw "bad nodeType";
		var ns = att.split(":");
		if (ns[0] == "xmlns") {
			var n = _node.namespace((ns[1] == null) ? "" : ns[1]);
			if (n != null)
				throw "Can't modify namespace";
			if (ns[1] == null)
				throw "Can't set default namespace";
