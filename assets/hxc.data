		{
			type = OPENGLES;
		}
		else
		{
			type = OPENGL;
		}
		var ereg = ~/[0-9]+[.]?[0-9]?/i;
		if (ereg.match(versionString))
		{
			version = Std.parseFloat(ereg.matched(0));
		}
		else
		{
			version = 2;
		}
		#else
		type = OPENGL;
		version = 2;
		#end
	}

