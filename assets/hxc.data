				case WeekOfYear(_): // w
					""; // not supported by Intl.DateTimeFormat
				case DayOfYear(_): // D
					""; // not supported by Intl.DateTimeFormat
				case DayOfWeekOccurence: // F
					""; // not supported by Intl.DateTimeFormat
				case WeekOfMonth: // W
					""; // not supported by Intl.DateTimeFormat
