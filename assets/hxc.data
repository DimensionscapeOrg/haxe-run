**/
@:native("DateInterval")
extern class DateInterval {
	var y: Int;
	var m: Int;
	var d: Int;
	var h: Int;
	var i: Int;
	var s: Int;
	var f: Float;
	var invert: Int;
	var days: EitherType<Int, Bool>;

	function new(duration: String);
	static function createFromDateString(datetime: String): DateInterval;
	function format(format: String): String;
}
