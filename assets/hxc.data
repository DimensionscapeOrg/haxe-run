	}

	@:noCompletion private function get_left():Float
	{
		return x;
	}

	@:noCompletion private function set_left(l:Float):Float
	{
		width -= l - x;
		x = l;
		return l;
	}

	@:noCompletion private function get_right():Float
	{
		return x + width;
	}

	@:noCompletion private function set_right(r:Float):Float
	{
