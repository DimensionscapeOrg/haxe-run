	}

	@:arrayAccess @:noCompletion private inline function set(index:Int, value:Int):Int
	{
		#if display
		#elseif flash
		this[index] = value;
		#else
		this.__resize(index + 1);
		this.set(index, value);
		#end
		return value;
	}

