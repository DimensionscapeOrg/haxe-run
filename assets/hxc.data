				child.__readGraphicsData(graphicsData, recurse);
			}
		}
	}

	@:noCompletion private override function __setStageReference(stage:Stage):Void
	{
		super.__setStageReference(stage);

		if (__children != null)
		{
			for (child in __children)
			{
