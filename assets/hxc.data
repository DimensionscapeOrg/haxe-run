	}

	@:noCompletion private function get_powerOfTwo():Bool
	{
		return ((buffer.width != 0)
			&& ((buffer.width & (~buffer.width + 1)) == buffer.width))
			&& ((buffer.height != 0) && ((buffer.height & (~buffer.height + 1)) == buffer.height));
