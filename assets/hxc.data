	}

	public function acquire():Void {
		semaphore.acquire();
	}

	public function tryAcquire(?timeout:Float):Bool {
		return timeout == null ? semaphore.acquire(false) : semaphore.acquire(true, timeout);
	}

	public function release():Void {
		semaphore.release();
	}
}
