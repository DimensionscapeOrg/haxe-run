		__tiles.insert(index, tile);
		tile.parent = this;
		__length++;

		__setRenderDirty();

		return tile;
	}

	/**
		Adds an Array of Tile instances to this TileContainer instance. The tiles
		are added to the front (top) of all other tiles in this TileContainer
