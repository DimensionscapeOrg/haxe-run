		#if (lime_cffi && !macro && lime_sdl_sound)
		var streamInfo = NativeCFFI.lime_sdl_sound_get_info_from_bytes(bytes);

		if (streamInfo != null)
		{
			return __fromSDLSoundInfo(streamInfo, bytes, null);
