		#if hl
		var result = NativeCFFI.lime_gl_get_active_attrib(__getObjectID(program), index);
		if (result != null)
		{
			return {
				size: result.size,
				type: result.type,
				name: CFFI.stringValue(result.name)
			};
		}
		else
		{
			return null;
		}
		#else
		return NativeCFFI.lime_gl_get_active_attrib(__getObjectID(program), index);
		#end
		#else
		return null;
		#end
	}

