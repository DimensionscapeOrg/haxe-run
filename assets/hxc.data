			case 0:
				vector.x = this[0];
				vector.y = this[1];
				vector.z = this[2];
				vector.w = this[3];

			case 1:
				vector.x = this[4];
				vector.y = this[5];
				vector.z = this[6];
				vector.w = this[7];

			case 2:
				vector.x = this[8];
				vector.y = this[9];
				vector.z = this[10];
				vector.w = this[11];

			case 3:
				vector.x = this[12];
				vector.y = this[13];
				vector.z = this[14];
				vector.w = this[15];

